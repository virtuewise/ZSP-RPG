{
  "schemaVersion": 1,
  "missions": [
    {
      "id": "M1",
      "order": 1,
      "title": "Episode 01 - THE MESSAGE",
      "location": "avondale_safehouse",
      "premise": "Emmanuel Mhara is gone. The message came from his phone: 'They have activated the protocol. Run.' Tinashe's flat is no longer safe, and the terminus locker is the only thread he has.",
      "invariants": ["message_received", "protocol_activated"],
      "objectives": [
        "Handle Mhara's message",
        "Leave the flat before Meridian arrives",
        "Find out who performed the cleaner's work"
      ],
      "contacts": ["amara"],
      "witnesses": ["lovemore"],
      "keyCharacters": ["mhara"],
      "endings": [],
      "start": "M1_BRIEF",
      "beats": [
        {
          "id": "M1_BRIEF",
          "type": "dialogue",
          "speaker": "amara",
          "text": "Tinashe? {OIS_CALLSIGN}? Listen carefully. Mhara is gone. His phone was found in a drain at the Mbare bus terminus. The message is live. They have activated the protocol.",
          "choices": [
            {
              "id": "accept",
              "text": "I'm moving.",
              "effects": {
                "trust": [{"contact": "amara", "delta": 0.15}],
                "flags": ["accepted_message"],
                "behavior": [{"action": "trust_contact", "target": "amara", "value": 1}]
              },
              "next": "M1_APPROACH"
            },
            {
              "id": "who_else",
              "text": "Amara. Who else knows?",
              "effects": {
                "trust": [{"contact": "amara", "delta": 0.1}],
                "flags": ["asked_who_knows"],
                "behavior": [{"action": "trust_contact", "target": "amara", "value": 1}]
              },
              "next": "M1_AMARA_ANSWERS"
            },
            {
              "id": "silence",
              "text": "...",
              "effects": {
                "trust": [{"contact": "amara", "delta": -0.05}],
                "flags": ["cold_start"]
              },
              "next": "M1_APPROACH"
            }
          ]
        },
        {
          "id": "M1_AMARA_ANSWERS",
          "type": "dialogue",
          "speaker": "amara",
          "text": "Muponda knows. Tafadzwa Dube does not, not yet. Lovemore at the terminus saw the locker man. He is alive. He is terrified. He is cooperating.",
          "choices": [
            {
              "id": "accept",
              "text": "I'll find him first.",
              "effects": {
                "trust": [{"contact": "amara", "delta": 0.1}],
                "flags": ["accepted_message", "know_lovemore"]
              },
              "next": "M1_APPROACH"
            }
          ]
        },
        {
          "id": "M1_APPROACH",
          "type": "route",
          "text": "Avondale. Your room behind the garage. A Meridian patrol is sweeping the street. They know you woke up. The front door is a trap. The back alley is darker. Or you could try the garage roof.",
          "routes": ["front_door", "back_alley"],
          "next": "M1_SWEEP"
        },
        {
          "id": "M1_SWEEP",
          "type": "combat",
          "text": "Boots on the stairs. Two Meridian cleaners, quiet professional faces, a carrier bag that is not for groceries. They are not here to arrest you.",
          "enemies": 2,
          "choices": [
            {
              "id": "evade",
              "text": "Slip through the garage and out the alley.",
              "check": {"stat": "stealth", "difficulty": 2},
              "success": {
                "text": "You move through the dark between the skip bins and down the alley. Behind you, a torch sweeps empty space.",
                "effects": {
                  "flags": ["evaded_flat_sweep"],
                  "behavior": [{"action": "stealth_avoid", "target": "meridian_cleaners", "value": 1}]
                },
                "next": "M1_LOVEMORE"
              },
              "failure": {
                "text": "One of them is faster than the other. You take him to the floor and step through the door as the second fires into the garage frame.",
                "effects": {
                  "flags": ["evaded_flat_sweep", "bloodied"],
                  "health": -1,
                  "heat": 2,
                  "behavior": [{"action": "gunfight", "target": "meridian_cleaners", "value": 1}]
                },
                "next": "M1_LOVEMORE"
              }
            },
            {
              "id": "fight",
              "text": "Meet them head-on.",
              "check": {"stat": "combat", "difficulty": 3},
              "success": {
                "text": "Two cleaners went down before the street could react. You are out of the driveway before the third siren answers.",
                "effects": {
                  "flags": ["flat_cleared"],
                  "heat": 2,
                  "behavior": [{"action": "gunfight", "target": "meridian_cleaners", "value": 1}]
                },
                "next": "M1_LOVEMORE"
              },
              "failure": {
                "text": "They are better than you. Barely. You leave blood on the garage floor and a body that will be identified by morning.",
                "effects": {
                  "flags": ["flat_cleared", "bloodied"],
                  "health": -2,
                  "heat": 3,
                  "behavior": [{"action": "gunfight", "target": "meridian_cleaners", "value": 1}]
                },
                "next": "M1_LOVEMORE"
              }
            }
          ]
        },
        {
          "id": "M1_LOVEMORE",
          "type": "choice",
          "speaker": "lovemore",
          "text": "MBARE BUS TERMINUS. 03:40. A porter named Lovemore hears the locker open. One man. A cleaner. Lovemore freezes behind a tomato crate at the exact moment the cleaner turns.",
          "choices": [
            {
              "id": "stop",
              "text": "Drop him before he reaches Lovemore.",
              "check": {"stat": "combat", "difficulty": 2},
              "success": {
                "text": "The cleaner folds before he can turn. Lovemore is alive. So is the evidence.",
                "effects": {
                  "witnesses": [{"id": "lovemore", "status": "spared", "cooperative": true}],
                  "keyCharacters": [{"id": "mhara", "status": "missing"}],
                  "flags": ["lovemore_saved"],
                  "heat": 1,
                  "behavior": [{"action": "gunfight", "target": "meridian_cleaner", "value": 1}, {"action": "witness_spared", "target": "lovemore", "value": 1}]
                },
                "next": "M1_CLOCK"
              },
              "failure": {
                "text": "You misread the angle. The cleaner sees you and Lovemore at the same time. By the time it is over, Lovemore is dead and the locker is open.",
                "effects": {
                  "witnesses": [{"id": "lovemore", "status": "killed", "cooperative": false}],
                  "flags": ["lovemore_dead"],
                  "heat": 2,
                  "health": -1,
                  "behavior": [{"action": "witness_killed", "target": "lovemore", "value": 1}]
                },
                "next": "M1_CLOCK"
              }
            },
            {
              "id": "observe",
              "text": "Stay down. See what he takes.",
              "effects": {
                "intel": ["cleaner_roster", "lovemore_statement"],
                "flags": ["observed_cleaner"],
                "behavior": [{"action": "stealth_avoid", "target": "meridian_cleaner", "value": 1}]
              },
              "next": "M1_CLOCK"
            },
            {
              "id": "leave",
              "text": "Walk past. Not your problem.",
              "effects": {
                "flags": ["walked_past_cleaner"],
                "behavior": [{"action": "stealth_avoid", "target": "meridian_cleaner", "value": 1}]
              },
              "next": "M1_CLOCK"
            }
          ]
        },
        {
          "id": "M1_CLOCK",
          "type": "dialogue",
          "speaker": "amara",
          "text": "It is the phone, Tinashe. Mhara's phone is in the culvert. Lovemore saw the cleaner. If you leave now, you'll never find it. If you stay, they will. Favour to yourself.",
          "variants": [
            {
              "requirements": ["flag:lovemore_dead"],
              "text": "Lovemore is dead. The phone is still in the drain. Meridian is already sweeping Chitungwiza. Move now, {OIS_CALLSIGN}."
            },
            {
              "requirements": ["flag:lovemore_saved"],
              "text": "Lovemore is alive. He is terrified and he is useful. The phone is in the culvert at Chitungwiza. Go now, {OIS_CALLSIGN}."
            }
          ],
          "choices": [
            {
              "id": "go",
              "text": "I'm on my way.",
              "effects": {
                "trust": [{"contact": "amara", "delta": 0.1}]
              },
              "next": "M1_END"
            }
          ]
        },
        {
          "id": "M1_END",
          "type": "mission_end",
          "text": "You leave Avondale behind you. Rain on the windshield. The phone in your pocket weighs more than any weapon you have ever carried.",
          "nextMission": "M2"
        }
      ]
    }
  ]
}
