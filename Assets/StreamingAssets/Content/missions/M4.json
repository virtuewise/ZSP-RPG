            },
            {
              "id": "sneak",
              "text": "Leave the truck. Walk out.",
              "check": {"stat": "stealth", "difficulty": 2},
              "success": {
                "text": "They walk out through the contractor yard as if they belong to it. The phone is in Amara's pocket.",
                "effects": {
                  "flags": ["escaped_nsd"],
                  "trust": [{"contact": "amara", "delta": 0.1}],
                  "behavior": [{"action": "stealth_avoid", "target": "nsd_checkpoint", "value": 1}]
                },
                "next": "M4_END"
              },
              "failure": {
