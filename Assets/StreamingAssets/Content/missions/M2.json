    {
      "id": "M2",
      "order": 2,
      "title": "Episode 02 - DEAD SIGNAL",
      "location": "chitungwiza",
      "premise": "Mhara's phone is in a Chitungwiza storm drain. Meridian is already there. Tinashe and Lovemore's evidence are the only things that matter now.",
      "invariants": ["phone_recovered_or_lost", "meridian_contact_made"],
      "objectives": [
        "Enter Chitungwiza without being picked up",
        "Recover Mhara's phone, or learn it was moved",
        "Learn what MSG-09 is"
      ],
      "contacts": ["amara"],
      "witnesses": ["lovemore"],
      "keyCharacters": ["mhara"],
      "endings": [],
      "start": "M2_OPEN",
      "beats": [
        {
          "id": "M2_OPEN",
          "type": "dialogue",
          "speaker": "amara",
          "text": "Chitungwiza. The culvert at the terminus. Lovemore gave us the grid reference. Victor Nhari was seen there twice this week. The phone could still be there. Or it could be thirty metres away in a Meridian van.",
          "variants": [
            {
              "requirements": ["contact_compromised:amara"],
              "text": "They know we are talking, {OIS_CALLSIGN}. They know you moved. Chitungwiza is hot. Use the market route, stay low, say nothing to anyone."
            }
          ],
          "choices": [
            {
              "id": "thanks",
              "text": "Then I won't be long.",
              "effects": {
                "trust": [{"contact": "amara", "delta": 0.1}],
                "behavior": [{"action": "trust_contact", "target": "amara", "value": 1}]
              },
              "next": "M2_ENTRY"
            },
            {
              "id": "lovemore",
              "text": "How is Lovemore?",
              "requirements": ["witness:lovemore:spared"],
              "effects": {
                "trust": [{"contact": "amara", "delta": 0.05}],
                "flags": ["asked_about_lovemore"]
              },
              "next": "M2_ENTRY"
            }
          ]
        },
        {
          "id": "M2_ENTRY",
          "type": "route",
          "text": "Chitungwiza, 05:10. Bus rank is already loud. The market is a maze. The safehouse roofs are exposed. And the drain is exactly where Mhara left his life.",
          "routes": ["bus_rank", "market", "safehouse_roof", "drain"],
          "next": "M2_CULVERT"
        },
        {
          "id": "M2_CULVERT",
          "type": "investigation",
          "text": "The culvert mouth is cold and full of leaves. Something heavy was dumped here recently. The water line is dark in one corner.",
          "maxSearches": 2,
          "areas": [
            {
              "id": "phone",
              "name": "The culvert",
              "text": "The phone is zipped into a plastic bag under the leaf line. Mhara's thumbprint is on the case. He wanted it found.",
              "stat": "stealth",
              "difficulty": 2,
              "intel": ["mhara_phone"],
              "effects": {
                "flags": ["recovered_mhara_phone"],
                "behavior": [{"action": "investigate", "target": "phone", "value": 1}]
              },
              "failureEffects": {
                "heat": 1,
                "flags": ["phone_noised"]
              }
            },
            {
              "id": "cleaner",
              "name": "The cleaner's kit",
              "text": "A Meridian cleaner's kit, still warm: latex gloves, a burner, a duty roster with SABLE circled twice.",
              "stat": "stealth",
              "difficulty": 3,
              "intel": ["cleaner_roster"],
              "effects": {
                "flags": ["recovered_cleaner_roster"],
                "behavior": [{"action": "investigate", "target": "cleaner", "value": 1}]
              },
              "failureEffects": {
                "heat": 1,
                "flags": ["cleaner_spotted"]
              }
            },
            {
              "id": "lovemore",
              "name": "Lovemore's position",
              "text": "Two minutes away. A rented room behind the church hall. He is breathing shakily and keeping the lights off.",
              "stat": "empathy",
              "difficulty": 2,
              "intel": ["lovemore_statement"],
              "effects": {
                "flags": ["lovemore_statement_taken"],
                "behavior": [{"action": "interrogate", "target": "lovemore", "value": 1}]
              },
              "failureEffects": {
                "heat": 1
              }
            }
          ],
          "next": "M2_MSG09"
        },
        {
          "id": "M2_MSG09",
          "type": "dialogue",
          "speaker": "amara",
          "text": "MSG-09. Three ministries paid into the same account for four years. 'Regional stability contracts.' It is a shell. It is Meridian. It is also the Silent Gate route: the arms moved through here.",
          "choices": [
            {
              "id": "silent_gate",
              "text": "Who authorised Silent Gate?",
              "effects": {
                "trust": [{"contact": "amara", "delta": 0.1}],
                "flags": ["asked_about_silent_gate"]
              },
              "next": "M2_MUPONDA"
            },
            {
              "id": "protect",
              "text": "Then who paid?",
              "effects": {
                "intel": ["msg09_account"],
                "flags": ["msg09_traced"]
              },
              "next": "M2_VAN"
            }
          ]
        },
        {
          "id": "M2_MUPONDA",
          "type": "dialogue",
          "speaker": "amara",
          "text": "General Muponda authorised it. Personally. He signed the Phase Two orders. And then the shipment was never what we were told it was.",
          "choices": [
            {
              "id": "call",
              "text": "I'll call him myself.",
              "effects": {
                "trust": [{"contact": "muponda", "delta": 0.2}],
                "behavior": [{"action": "trust_contact", "target": "muponda", "value": 1}]
              },
              "next": "M2_VAN"
            },
            {
              "id": "hold",
              "text": "Not yet.",
              "effects": {
                "flags": ["withheld_muponda_call"]
              },
              "next": "M2_VAN"
            }
          ]
        },
        {
          "id": "M2_VAN",
          "type": "chase",
          "text": "A Meridian van grinds up the drain access as you are leaving. Lovemore is still warm in your coat. They are not here for him. They are here for you.",
          "choices": [
            {
              "id": "run",
              "text": "Run through the market, lose them on foot.",
              "check": {"stat": "stealth", "difficulty": 2},
              "success": {
                "text": "You go through a stall roof, down the church hall, and out the far side. They are still there when you are gone.",
                "effects": {
                  "flags": ["lost_meridian_van"],
                  "behavior": [{"action": "stealth_avoid", "target": "meridian_van", "value": 1}]
                },
                "next": "M2_END"
              },
              "failure": {
                "text": "You catch a bullet in the shoulder. You make the alley, but they get a photograph of your face.",
                "effects": {
                  "flags": ["lost_meridian_van"],
                  "health": -1,
                  "heat": 2,
                  "behavior": [{"action": "gunfight", "target": "meridian_van", "value": 1}]
                },
                "next": "M2_END"
              }
            },
            {
              "id": "vehicle",
              "text": "Take the kombi and go down the highway.",
              "check": {"stat": "driving", "difficulty": 2},
              "success": {
                "text": "The kombi launches down the road with Meridian behind it. You drop them at the railway crossing and leave on foot for the safehouse.",
                "effects": {
                  "flags": ["lost_meridian_van"],
                  "heat": 2,
                  "behavior": [{"action": "vehicle_chase", "target": "meridian_van", "value": 1}]
                },
                "next": "M2_END"
              },
              "failure": {
                "text": "The kombi stalls at the crossing. You are out and gone, but they have your face and the rain is not enough.",
                "effects": {
                  "flags": ["lost_meridian_van"],
                  "heat": 2,
                  "health": -1,
                  "behavior": [{"action": "vehicle_chase", "target": "meridian_van", "value": 1}]
                },
                "next": "M2_END"
              }
            },
            {
              "id": "fight",
              "text": "Stand your ground and make them pay.",
              "check": {"stat": "combat", "difficulty": 3},
              "success": {
                "text": "You drop both cleaners before the second shot. The market is watching. They will remember your face, but as a survivor.",
                "effects": {
                  "flags": ["lost_meridian_van"],
                  "heat": 3,
                  "behavior": [{"action": "gunfight", "target": "meridian_van", "value": 1}]
                },
                "next": "M2_END"
              },
              "failure": {
                "text": "They take you down. You wake on a concrete floor with a boot on your neck. You are still alive. That is what matters.",
                "effects": {
                  "flags": ["lost_meridian_van", "captured_by_meridian"],
                  "health": -2,
                  "heat": 3,
                  "behavior": [{"action": "gunfight", "target": "meridian_van", "value": 1}]
                },
                "next": "M2_END"
              }
            }
          ]
        },
        {
          "id": "M2_END",
          "type": "mission_end",
          "text": "You reach the Avondale safehouse before dawn. The door is open. Something is wrong inside.",
          "nextMission": "M3"
        }
      ]
    }
